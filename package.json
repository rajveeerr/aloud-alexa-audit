{
  "name": "answerable",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -b",
    "cli": "bun apps/cli/src/audit.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "api": "bun apps/api/src/main.ts",
    "key:add": "bun apps/api/src/add-key.ts",
    "worker": "bun apps/worker/src/main.ts",
    "dev": "bun packages/db/src/migrate.ts && bun apps/api/src/main.ts --with-worker",
    "evals": "bun evals/run.ts",
    "evals:check": "bun evals/run.ts --check",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "diagrams": "bun diagrams/build.ts",
    "study": "bun study/run.ts && bun study/analyze.ts && bun study/chart.ts",
    "study:record": "bun study/run.ts --record",
    "docker:build": "docker build -t answerable-api .",
    "docker:run": "docker run --rm -p 4100:4100 --add-host=host.docker.internal:host-gateway -e DATABASE_URL=mysql://root:answerable@host.docker.internal:3317/answerable_docker -e REDIS_URL=redis://host.docker.internal:6389 -e REDIS_PREFIX=answerable-docker -e WEB_ORIGIN=http://localhost:5181 answerable-api"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
