{
  "name": "answerable",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -b",
    "cli": "bun apps/cli/src/audit.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "api": "bun apps/api/src/main.ts",
    "worker": "bun apps/worker/src/main.ts",
    "dev": "bun packages/db/src/migrate.ts && bun apps/api/src/main.ts --with-worker",
    "evals": "bun evals/run.ts",
    "evals:check": "bun evals/run.ts --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
