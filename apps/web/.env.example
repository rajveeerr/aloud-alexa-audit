# Copy to apps/web/.env.local for local development.
VITE_API_URL=http://localhost:4100
# Matches the API's API_KEY_DEV. Internal and demo use only: anything VITE_* ends up in the app's
# bundle. In production, put the app behind a server-side proxy that adds the key.
VITE_API_KEY=dev-key
# 1 runs the app on saved reports with no API at all.
VITE_USE_MOCKS=
