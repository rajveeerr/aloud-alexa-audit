GEMINI_API_KEY=
SERPAPI_KEY=

# Storage (docker-compose.yml defaults)
DATABASE_URL=mysql://root:aloud@127.0.0.1:3317/aloud
# 1 connects to MySQL over verified TLS (TiDB Cloud needs it). Same as adding ?ssl=true to the URL.
DATABASE_SSL=
REDIS_URL=redis://127.0.0.1:6389
REDIS_PREFIX=aloud

# API
PORT=4100
WEB_ORIGIN=http://localhost:5180
# Seeded as an API key on startup, only when set and NODE_ENV isn't production. Local dev only.
API_KEY_DEV=dev-key
# Number of proxy hops in front of the API (1 on Render or Fly), so rate limits see the client IP.
# Must be a count, not "true": "true" would trust any X-Forwarded-For a client sends. Empty = no proxy.
TRUST_PROXY=
PUBLIC_RATE_LIMIT=5
PUBLIC_RATE_WINDOW_SEC=3600
# 1 lets widget audits fetch unsaved listings through SerpApi
PUBLIC_LIVE=
# 1 runs the worker inside the API process (same as --with-worker)
RUN_WORKER=
# 1 for a public demo whose app bundle carries its key: keyed audits use saved listings only
# (live forced off, no paste), bulk jobs take at most 10 ASINs, rescore is refused.
DEMO_READONLY=

# Worker
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=10
FIXTURES_DIR=
LLM_CACHE_DIR=
IMAGE_CACHE_DIR=
RETRY_BACKOFF_MS=10000
AUDIT_WEBHOOK_URL=
AUDIT_WEBHOOK_SECRET=

# Integration tests (bun test)
TEST_DATABASE_URL=mysql://root:aloud@127.0.0.1:3317/aloud_test
TEST_REDIS_URL=redis://127.0.0.1:6389
SKIP_INTEGRATION=
